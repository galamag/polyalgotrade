# ─── Secrets (NEVER commit) ───────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
secrets/
**/private_key*
**/wallet*.json

# ─── Data (large / regenerable — kept out of git) ─────────────────────────
# Only the top-level data/ directory (raw RPC dumps, processed parquet, etc.).
# This must NOT match tests/data/ or src/pat/data/ — hence the leading slash.
/data/
*.csv
*.parquet
*.duckdb
*.sqlite
*.db
logs/
*.log

# ─── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.uv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ─── Notebooks ──────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── OS / IDE ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/

# ─── Obsidian (docs/ is an Obsidian vault) ─────────────────────────────────
docs/.obsidian/
.obsidian/
.trash/

# ─── Local model artifacts (Ollama pulls live outside repo) ──────────────────
models/
*.gguf
