# Copy to .env (gitignored) and fill in. NEVER commit the real .env.
# Use a DEDICATED trading wallet funded with only the active bankroll.

# ─── Polymarket (CTF Exchange V2) ──────────────────────────────────────────
# Private key of the dedicated trading wallet (L1 auth). Keep secret.
PK=
# Derived API credentials (L2) — created from PK on first run.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137                 # Polygon mainnet (80002 = Amoy testnet, no liquidity)

# ─── Polygon RPC (historical data) ─────────────────────────────────────────
POLYGON_RPC_URL=https://polygon-rpc.com   # public; paid Alchemy/QuickNode for big scans
POLYGON_MAX_BLOCK_RANGE=1000

# ─── Kalshi ────────────────────────────────────────────────────────────────
KALSHI_API_KEY=
KALSHI_API_SECRET=
KALSHI_HOST=https://api.elections.kalshi.com   # demo: https://demo-api.kalshi.com

# ─── Runtime ───────────────────────────────────────────────────────────────
MODE=backtest                # backtest | paper | live
LOG_LEVEL=INFO
